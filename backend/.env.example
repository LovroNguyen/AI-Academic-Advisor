# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/acadai"
# Required, at least 16 characters. The server refuses to start without it.
JWT_SECRET="<long-random-string>"
JWT_EXPIRES_IN="7d"
PORT=3000

# Main AI provider: Claude (paid API key from platform.claude.com). Tried first.
ANTHROPIC_API_KEY=""
# Optional; defaults to the cheapest current model.
CLAUDE_MODEL="claude-haiku-5-5"

# Backup AI provider (OpenRouter free models), used when Claude is not set or fails.
# Leave every AI key empty to use only the built-in deterministic answers.
OPENROUTER_API_KEY=""
# Optional backup keys (e.g. other accounts). Used in order when a key hits the free daily limit.
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_MODEL="openrouter/free"

# Face recognition service (must match face-service/.env)
FACE_SERVICE_URL="http://127.0.0.1:8001"
FACE_SERVICE_API_KEY="<same-value-as-face-service/.env>"
